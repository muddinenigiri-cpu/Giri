{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "giri-datafactory"
		},
		"AzureDataLakeStorageGen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorageGen2'"
		},
		"AzureSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSQL'"
		},
		"get_meta_data_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'get_meta_data'"
		},
		"AzureDataLakeStorageGen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://giristorageaccountgen2.dfs.core.windows.net/"
		},
		"AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "giri.database.windows.net"
		},
		"AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "GiRi@sql"
		},
		"AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "giriadmin"
		},
		"get_meta_data_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://giristorageaccountgen2.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "giri-datafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorageGen2_accountKey": {
						"value": "[parameters('AzureDataLakeStorageGen2_accountKey')]"
					},
					"AzureSQL_password": {
						"value": "[parameters('AzureSQL_password')]"
					},
					"get_meta_data_accountKey": {
						"value": "[parameters('get_meta_data_accountKey')]"
					},
					"AzureDataLakeStorageGen2_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorageGen2_properties_typeProperties_url')]"
					},
					"AzureSQL_properties_typeProperties_server": {
						"value": "[parameters('AzureSQL_properties_typeProperties_server')]"
					},
					"AzureSQL_properties_typeProperties_database": {
						"value": "[parameters('AzureSQL_properties_typeProperties_database')]"
					},
					"AzureSQL_properties_typeProperties_userName": {
						"value": "[parameters('AzureSQL_properties_typeProperties_userName')]"
					},
					"get_meta_data_properties_typeProperties_url": {
						"value": "[parameters('get_meta_data_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "giri-datafactory_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'giri-datafactory_ArmTemplate_0')]"
			]
		}
	]
}